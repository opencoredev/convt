# apps/web/.dev.vars is written by scripts/dev-web.sh from .convt-dev/services.env.
# Never commit .dev.vars. Production values are Worker vars and secrets (see
# docs/p6-accounts-plan.md, "Accounts and secrets Leo creates later").
ENV=development
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=generated-by-scripts-db-sh
MAIL_TRANSPORT=mailpit
MAIL_FROM=convt <hello@convt.test>
MAILPIT_URL=http://127.0.0.1:8025
OAUTH_MOCK_URL=http://127.0.0.1:4100

# Production and staging use MAIL_TRANSPORT=sequenzy and the SEQUENZY_API_KEY
# Worker secret. MAIL_FROM is convt <hello@convt.app>. Local mail stays in Mailpit.

# Optional: PostHog web analytics (public project API key). Leave unset locally
# to skip tracking. Production sets these in wrangler.jsonc vars.
# POSTHOG_KEY=phc_...
# POSTHOG_HOST=https://us.i.posthog.com

# Optional: the Feedback form's PostHog API survey. Needs POSTHOG_KEY too; without
# both, /api/feedback answers 503. Point POSTHOG_HOST at a local stub to inspect
# the event instead of sending it.
# POSTHOG_FEEDBACK_SURVEY_ID=
# POSTHOG_FEEDBACK_MESSAGE_QUESTION_ID=
# POSTHOG_FEEDBACK_EMAIL_QUESTION_ID=
