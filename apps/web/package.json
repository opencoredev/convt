    "@tanstack/devtools-vite": "0.8.7",
    "@tanstack/router-cli": "^1.168.0",
    "@types/bun": "1.4.2",
    "@types/node": "^22.10.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^6.0.2",
    "vite": "^8.3.3",
    "wrangler": "^4.164.0"
  },
