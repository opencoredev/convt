{
  "name": "@convt/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "bun scripts/generate-content.ts && vite build",
    "generate-content": "bun scripts/generate-content.ts",
