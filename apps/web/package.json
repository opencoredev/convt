{
  "name": "@convt/web",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "bun scripts/generate-content.ts && vite build",
    "build:landing": "bash scripts/build-landing.sh",
    "generate-content": "bun scripts/generate-content.ts",
    "preview": "vite preview",
    "deploy": "bash ../../scripts/deploy-worker.sh web",
    "check-types": "tsc --noEmit",
    "test": "bun test test/unit",
    "test:integration": "bash ../../packages/db/scripts/test-db.sh bun test test/integration"
  },
  "dependencies": {
    "@convt/billing": "workspace:*",
    "@convt/db": "workspace:*",
    "@convt/license": "workspace:*",
    "@convt/mail": "workspace:*",
    "@convt/sdk": "workspace:*",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-devtools": "0.10.15",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.4",
    "@tanstack/react-start": "1.169.7",
    "better-auth": "1.7.27",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1",
    "posthog-js": "1.268.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@better-auth/core": "1.7.27",
    "@cloudflare/vite-plugin": "^1.70.1",
