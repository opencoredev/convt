  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "cvt_live_ API key. Browser converters use a 5-minute account-scoped cvt_web_ credential issued by the site Worker."
      }
    },
    "schemas": {
      "Job": {
        "type": "object",
        "required": ["id", "status", "expires_at"],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["created", "uploaded", "queued", "running", "succeeded", "failed", "cancelled"]
          },
          "input_format": {
            "type": "string"
          },
          "target_format": {
            "type": "string"
          },
          "input_bytes": {
            "type": ["integer", "null"]
          },
          "attempt": {
            "type": "integer"
          },
          "error_code": {
            "type": ["string", "null"]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
