{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/(about|privacy)/",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "/(index\\.html)?",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "missing": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown\\s*;\\s*q\\s*=\\s*0(\\.0{0,3})?\\s*(,.*)?"
        }
      ],
      "dest": "/index.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "/(about|privacy)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "missing": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown\\s*;\\s*q\\s*=\\s*0(\\.0{0,3})?\\s*(,.*)?"
        }
      ],
      "dest": "/$1.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "/(about|privacy)",
      "dest": "/$1.html",
      "headers": {
        "Vary": "Accept"
      }
    },
    {
      "src": "/(about|privacy)\\.html",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "/convert/",
      "status": 308,
      "headers": {
        "Location": "/convert"
      }
    },
    {
      "src": "/convert/([a-z0-9-]+)/",
      "status": 308,
      "headers": {
        "Location": "/convert/$1"
      }
    },
    {
      "src": "/convert",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "missing": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown\\s*;\\s*q\\s*=\\s*0(\\.0{0,3})?\\s*(,.*)?"
        }
      ],
      "dest": "/convert.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "/convert/([a-z0-9-]+)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "missing": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown\\s*;\\s*q\\s*=\\s*0(\\.0{0,3})?\\s*(,.*)?"
        }
      ],
      "dest": "/convert/$1.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      },
      "check": true
    },
    {
      "src": "/convert",
      "dest": "/convert/index.html",
      "headers": {
        "Vary": "Accept"
      }
    },
    {
      "src": "/convert/([a-z0-9-]+)",
      "dest": "/convert/$1/index.html",
      "headers": {
        "Vary": "Accept"
      },
      "check": true
    },
    {
      "src": "/(index\\.html)?",
      "headers": {
        "Vary": "Accept"
      },
      "continue": true
    },
    {
      "src": "/.*\\.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8"
      },
      "continue": true
    },
    {
      "src": "/assets/.*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "missing": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown\\s*;\\s*q\\s*=\\s*0(\\.0{0,3})?\\s*(,.*)?"
        }
      ],
      "dest": "/404.md",
      "status": 404,
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "/.*",
      "dest": "/404.html",
      "status": 404,
      "headers": {
        "Vary": "Accept"
      }
    }
  ]
}
