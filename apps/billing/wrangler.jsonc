{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "convt-billing",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  // Production values. Secrets (POLAR_ACCESS_TOKEN, POLAR_WEBHOOK_SECRET,
  // SEQUENZY_API_KEY, LICENSE_SIGNING_KEY) are set with `wrangler secret put` on this
  // Worker only; the site Worker never holds them. Local development overrides
  // these from apps/billing/.dev.vars (scripts/dev-web.sh).
  "vars": {
    "ENV": "production",
    "SITE_URL": "https://convt.app",
    "BILLING_CATALOG": "production",
    "POLAR_DESKTOP_LIFETIME_PRODUCT_ID": "SET_IN_WORKER_ENV",
    "POLAR_DESKTOP_LIFETIME_PRICE_ID": "SET_IN_WORKER_ENV",
    "MAIL_TRANSPORT": "sequenzy",
    "MAIL_FROM": "convt <hello@convt.app>",
    // Leo's address for the daily billing digest.
    "ALERT_EMAIL": "leodoesdev@gmail.com",
    // The public half of the production signing key; release builds embed the same
    // key as CONVT_LICENSE_PUBKEY.
    "LICENSE_PUBLIC_KEY": "FifI4kZfp25-La18pwNa4CJ751s4hDP68D60bp9rQoY",
    // Same public project key the site uses. Safe in Worker vars.
    "POSTHOG_KEY": "phc_yg96HDaDax6n2MmN7QyzvJjSh5qq2AwMUvaRnhmbJwMw",
    "POSTHOG_HOST": "https://us.i.posthog.com",
  },
  // Only the webhook path is public; the site reaches everything else through its
  // service binding to the BillingRpc entrypoint.
  "routes": [{ "pattern": "convt.app/webhooks/*", "zone_name": "convt.app" }],
  "workers_dev": false,
  // Hyperdrive "convt-billing-production": Railway Postgres as convt_billing, caching
  // disabled, Railway's certificate verified. Locally the Vite plugin and Wrangler read
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_BILLING.
  "hyperdrive": [{ "binding": "HYPERDRIVE_BILLING", "id": "31daf0d7233e484ca7a6cedc0b5c0445" }],
  "triggers": {
    // Outbox drain and deletions every minute; the reconciler every 15 minutes;
    // the daily check at 03:17 UTC.
    "crons": ["* * * * *", "*/10 * * * *", "*/15 * * * *", "17 3 * * *"],
  },
  "env": {
    "staging": {
      "name": "convt-billing-staging",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "ENV": "staging",
        // Empty: staging sends no PostHog events.
        "POSTHOG_KEY": "",
        "POSTHOG_HOST": "https://us.i.posthog.com",
        "BILLING_CATALOG": "sandbox",
        "POLAR_DESKTOP_LIFETIME_PRODUCT_ID": "SET_IN_WORKER_ENV",
        "POLAR_DESKTOP_LIFETIME_PRICE_ID": "SET_IN_WORKER_ENV",
        "SITE_URL": "https://convt-web-staging.leoisadev.workers.dev",
        "MAIL_TRANSPORT": "sequenzy",
        "MAIL_FROM": "convt <hello@convt.app>",
        "ALERT_EMAIL": "leodoesdev@gmail.com",
        // Staging's own signing key, separate from production.
        "LICENSE_PUBLIC_KEY": "KtufCO-UrY5lb7CcO7vsyqDd-Mh2Da9bcbD4rBZ0hPY",
      },
      // Hyperdrive "convt-billing-staging", caching disabled.
      "hyperdrive": [{ "binding": "HYPERDRIVE_BILLING", "id": "c59ed0ee6c8b4dcab137d1549e5984d5" }],
      "triggers": { "crons": ["* * * * *", "*/10 * * * *", "*/15 * * * *", "17 3 * * *"] },
    },
  },
}
