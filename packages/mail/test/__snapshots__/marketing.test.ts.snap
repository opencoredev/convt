"
,
}
`;

exports[`marketing templates snapshots 6`] = `"<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><meta name="supported-color-schemes" content="light dark"><title>welcome to convt</title><style>:root{color-scheme:light dark;supported-color-schemes:light dark}@media (prefers-color-scheme: dark){.bg{background:#0a0b0b!important}.ink{color:#edefee!important}.ink2{color:#a1a6a3!important}.ink3{color:#868b88!important}.brand,.link{color:#3fcb84!important}.rule{border-color:#232726!important}.lt{display:none!important}.dk{display:block!important;max-height:none!important}}[data-ogsc] .ink{color:#edefee!important}[data-ogsc] .ink2{color:#a1a6a3!important}[data-ogsc] .brand,[data-ogsc] .link{color:#3fcb84!important}</style></head><body class="bg" style="margin:0;padding:0;background:#ffffff"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="bg" bgcolor="#ffffff"><tr><td align="center"><table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px"><tr><td style="padding:48px 48px 0 48px"><img class="lt" src="https://convt.app/brand/convt-lockup-on-light.png" width="89" height="22" alt="convt" style="display:block;width:89px;height:22px;border:0"><!--[if !mso]><!--><img class="dk" src="https://convt.app/brand/convt-lockup-on-dark.png" width="89" height="22" alt="convt" style="display:none;width:89px;height:22px;border:0;max-height:0;overflow:hidden;mso-hide:all"><!--<![endif]--></td></tr><tr><td class="ink" style="padding:36px 48px 0 48px;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:16px;line-height:26px;color:#0a0a0a"><p style="margin:0 0 16px 0">hey {{firstName|there}},</p><p style="margin:0 0 16px 0">i'm leo, i'm making convt. thanks for giving it a try.</p><p style="margin:0 0 16px 0">you've got 7 days free. download it, right-click any file, pick a format. that's it, and it all stays on your computer.</p><table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 24px 0"><tr><td bgcolor="#127a47" style="background:#127a47;border-radius:8px"><a href="https://convt.app/download" style="display:inline-block;padding:11px 20px;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none">download convt</a></td></tr></table><p style="margin:0">if you have any feature requests, suggestions, bug reports or questions, just reply here.</p><p class="ink" style="margin:28px 0 0 0">leo</p></td></tr><tr><td style="padding:40px 48px 0 48px"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="rule" style="border-top:1px solid #e6e8e7;font-size:0;line-height:0">&nbsp;</td></tr></table></td></tr><tr><td class="ink3" style="padding:14px 48px 40px 48px;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12px;line-height:18px;color:#6c716e">{{postalAddress}} &middot; <a class="ink3" href="{{unsubscribeUrl}}" style="color:#6c716e;text-decoration:underline">unsubscribe</a> &middot; <a class="ink3" href="{{preferencesUrl}}" style="color:#6c716e;text-decoration:underline">preferences</a></td></tr></table></td></tr></table></body></html>"`;
