  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "cvt_live_ API key. Browser converters use a 5-minute account-scoped cvt_web_ credential issued by the site Worker."
      }
    },
    "schemas": {
      "Job": {
        "type": "object",
        "required": ["id", "status", "expires_at"],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["created", "uploaded", "queued", "running", "succeeded", "failed", "cancelled"]
          },
          "input_format": {
            "type": "string"
          },
          "target_format": {
            "type": "string"
          },
          "options": {
            "$ref": "#/components/schemas/Options"
          },
          "input_bytes": {
            "type": ["integer", "null"]
          },
          "attempt": {
            "type": "integer"
          },
          "error_code": {
            "type": ["string", "null"]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Options": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "quality": {
            "type": ["integer", "null"],
            "minimum": 1,
            "maximum": 100
          },
          "max_size": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "video_height": {
            "type": ["integer", "null"],
            "minimum": 2,
            "multipleOf": 2
          },
          "audio_bitrate": {
            "type": ["integer", "null"],
            "minimum": 8,
            "maximum": 640
          },
          "pages": {
            "type": ["string", "null"],
            "pattern": "^[1-9][0-9]*(-([1-9][0-9]*)?)?$"
          },
          "dpi": {
            "type": ["integer", "null"],
            "minimum": 18,
            "maximum": 1200
          },
          "video_codec": {
            "type": ["string", "null"],
            "enum": ["h264", "hevc", null]
          },
          "background": {
            "type": ["string", "null"]
          },
          "strip_audio": {
            "type": "boolean",
            "default": false
          },
          "target_size": {
            "type": ["integer", "null"],
            "minimum": 10000,
            "description": "Largest output file in bytes. Lowers quality, and image size, to fit."
          },
          "strip_metadata": {
            "type": "boolean",
            "default": false,
            "description": "Leave EXIF, GPS and other metadata out of the output."
          },
          "trim_start": {
            "type": ["number", "string", "null"],
            "description": "Start video or audio output here: seconds (12.5) or a timestamp (\"1:30\")."
          },
          "trim_end": {
            "type": ["number", "string", "null"],
            "description": "End video or audio output here: seconds (12.5) or a timestamp (\"1:30\")."
          },
          "fps": {
            "type": ["integer", "null"],
            "minimum": 1,
            "maximum": 120,
            "description": "Frames per second for video and GIF output."
          }
        }
      }
    }
  }
}
