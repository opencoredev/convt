  "query": "select e.id,e.job_id as \"job_id!\",e.user_id as \"user_id!\",e.quantity,e.occurred_at from usage_events e join subscriptions s on s.id=e.subscription_id where e.kind='api_conversion' and e.reported_at is null and e.user_id is not null and s.provider='polar' order by e.occurred_at limit 100",
