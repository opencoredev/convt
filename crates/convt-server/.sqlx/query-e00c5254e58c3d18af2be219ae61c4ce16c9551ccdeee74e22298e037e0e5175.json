{
  "db_name": "PostgreSQL",
  "query": "update cloud_jobs j set webhook_next_at=now()+interval '120 seconds' from (select id from cloud_jobs where webhook_url is not null and webhook_delivered_at is null and webhook_attempts<$1 and status in ('succeeded','failed','cancelled') and (webhook_next_at is null or webhook_next_at<=now()) order by webhook_next_at nulls first limit $2 for update skip locked) c where j.id=c.id returning j.id, j.user_id, j.webhook_url as \"webhook_url!\", j.webhook_attempts, j.webhook_next_at as \"lease!\", coalesce((select version from webhook_secrets w where w.user_id=j.user_id),1) as \"secret_version!\"",
