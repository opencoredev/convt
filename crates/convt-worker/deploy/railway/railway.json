    "dockerfilePath": "crates/convt-worker/deploy/railway/Dockerfile"
  },
  "deploy": {
    "numReplicas": 3,
    "restartPolicyType": "ALWAYS",
    "sleepApplication": false,
    "drainingSeconds": 30
  }
}
