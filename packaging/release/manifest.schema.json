{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convt.app/schemas/release-manifest-v1.json",
  "title": "convt website and update manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "issued_at",
    "expires_at",
    "distribution_ready",
    "purchase_url",
    "builds"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at": {
      "type": "integer",
      "minimum": 1
    },
    "distribution_ready": {
      "type": "boolean"
    },
    "purchase_url": {
      "type": "string",
      "pattern": "^https://",
      "format": "uri"
    },
    "builds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/build"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "kind", "url", "size", "sha256"],
      "properties": {
        "platform": {
          "enum": ["linux-x86_64", "macos-arm64", "windows-x86_64", "source"]
        },
        "kind": {
          "enum": ["tar.gz", "AppImage", "deb", "rpm", "dmg", "zip", "msi", "exe"]
        },
        "url": {
          "type": "string",
          "pattern": "^https://",
          "format": "uri"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "platform": {
                "const": "source"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "enum": ["tar.gz"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "platform": {
                "const": "linux-x86_64"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "enum": ["tar.gz", "AppImage", "deb", "rpm"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "platform": {
                "const": "macos-arm64"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "enum": ["dmg", "zip"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "platform": {
                "const": "windows-x86_64"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "enum": ["msi", "exe", "zip"]
              }
            }
          }
        }
      ]
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "build_date", "artifacts", "source"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "build_date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/binaryArtifact"
          }
        },
        "source": {
          "$ref": "#/$defs/sourceArtifact"
        }
      }
    },
    "binaryArtifact": {
      "allOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "properties": {
            "platform": {
              "not": {
                "const": "source"
              }
            }
          }
        }
      ]
    },
    "sourceArtifact": {
      "allOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "properties": {
            "platform": {
              "const": "source"
            },
            "kind": {
              "const": "tar.gz"
            }
          }
        }
      ]
    }
  }
}
