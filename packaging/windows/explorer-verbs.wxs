        <RegistryKey Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\ConvertWithConvt\shell\90_more" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Name="MUIVerb" Value="More options…" />
