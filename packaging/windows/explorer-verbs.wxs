<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <StandardDirectory Id="SendToFolder">
      <Component Id="SendToShortcut" Guid="*">
        <Shortcut Id="ConvtSendTo" Name="Convt" Target="[INSTALLFOLDER]convt-app.exe" Arguments="open --" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKMU" Key="Software\Convt" Name="SendTo" Type="string" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>
  <Fragment>
    <ComponentGroup Id="ExplorerVerbs">
      <ComponentRef Id="SendToShortcut" />
      <Component Id="ExplorerVerb_jpg" Guid="*">
        <RegistryKey Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\ConvertWithConvt" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Name="MUIVerb" Value="Convert with Convt" KeyPath="yes" />
          <RegistryValue Type="string" Name="Icon" Value="[INSTALLFOLDER]convt-app.exe,0" />
          <RegistryValue Type="string" Name="MultiSelectModel" Value="Player" />
        </RegistryKey>
        <RegistryKey Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\ConvertWithConvt\shell\10_png" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Name="MUIVerb" Value="PNG" />
          <RegistryValue Type="string" Name="MultiSelectModel" Value="Document" />
        </RegistryKey>
        <RegistryKey Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\ConvertWithConvt\shell\10_png\command" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]convt-app.exe&quot; open --to png -- &quot;%1&quot;" />
        </RegistryKey>
        <RegistryKey Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\ConvertWithConvt\shell\20_webp" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Name="MUIVerb" Value="WEBP" />
          <RegistryValue Type="string" Name="MultiSelectModel" Value="Document" />
