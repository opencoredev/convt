        <RegistryKey Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\ConvertWithConvt\shell\20_webp\command" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]convt-app.exe&quot; open --to webp -- &quot;%1&quot;" />
