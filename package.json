{
  "name": "convt",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "bash scripts/dev-web.sh",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "oxlint && oxfmt --check",
    "rs:build": "cargo build",
    "rs:test": "cargo test",
    "rs:check": "cargo fmt --all --check && cargo clippy --all-targets -- -D warnings",
    "app": "cargo run -p convt-app",
    "cli": "cargo run -p convt-cli --",
    "server": "cargo run -p convt-server",
    "setup": "bash scripts/setup.sh",
    "test:matrix": "bash scripts/test-engines.sh --test matrix full_matrix -- --ignored --nocapture",
    "bundle:linux": "bash packaging/linux/build.sh",
    "bundle:appimage": "bash packaging/linux/appimage.sh",
    "package:deb": "bash packaging/linux/package.sh deb",
    "package:rpm": "bash packaging/linux/package.sh rpm",
    "package:linux": "bash packaging/linux/package.sh",
    "test:packages": "bash packaging/linux/test-packages.sh",
    "db:up": "bash scripts/db.sh up",
    "db:down": "bash scripts/db.sh down",
    "db:migrate": "bun packages/db/src/cli/migrate.ts",
    "db:rollback": "bun packages/db/src/cli/rollback.ts",
    "db:reset": "bun packages/db/src/cli/reset.ts",
    "db:seed": "bun packages/db/src/cli/seed.ts",
    "dev:sign-in": "bun apps/web/scripts/dev-sign-in.ts",
    "db:ci": "bash packages/db/scripts/ci.sh",
    "billing:outbox": "bun packages/billing/src/cli/outbox.ts",
    "billing:backfill": "bun packages/billing/src/cli/backfill.ts",
    "analytics:backfill-signups": "bun packages/db/src/cli/backfill-signups.ts",
    "marketing:backfill": "bun packages/db/src/cli/marketing-backfill.ts",
    "license:keygen": "bun packages/billing/src/cli/keygen.ts",
    "release:linux": "bash scripts/release-linux.sh",
    "update:keygen": "bun scripts/release/manifest.ts keygen",
    "release:manifest": "bun scripts/release/manifest.ts",
    "release:upload": "bash scripts/release/upload.sh",
    "test:load": "bun tools/loadtest/src/main.ts",
    "changeset": "changeset",
    "release:version": "changeset version && python3 scripts/release/sync-version.py && bun install --lockfile-only",
    "release:check-version": "python3 scripts/release/sync-version.py --check"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "2.29.7",
    "jsonc-parser": "3.3.1",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "latest",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "dompurify@<3.4.17": "3.4.17",
    "esbuild": "0.28.1",
    "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
    "glob@>=13.0.0 <14.0.2": "14.0.2",
    "ip-address@<10.7.4": "10.7.4",
    "launch-editor@<2.14.2": "2.14.2",
    "mermaid@>=12.0.0 <12.2.0": "12.2.0",
    "minimatch@>=10.0.0 <11.0.1": "11.0.1",
    "path-to-regexp@>=4.0.0 <6.3.0": "6.3.0",
    "postcss-selector-parser@<6.1.5": "6.1.5",
    "qs@>=6.7.0 <6.16.1": "6.16.1",
    "seroval@<1.6.11": "1.6.11",
    "sharp@<0.35.5": "0.35.5",
    "solid-js@>=1.9.0 <1.9.18": "1.9.18",
    "undici@>=7.0.0 <7.30.1": "7.30.1",
    "undici@>=8.0.0 <8.12.2": "8.12.2"
  },
  "packageManager": "bun@1.4.2"
}
